# Copy this file to `.env` in the same folder (final_hidden_india/.env)
# Vite only exposes variables prefixed with VITE_

# Google Sign-In (optional — email/password login works without this)
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID → Web application
# 3. Add authorized origin: http://localhost:3000
# 4. Paste your Client ID below (NOT the secret)
VITE_GOOGLE_CLIENT_ID=707157847968-lbcs20chfuhjgttpsrie7gopv7jbujar.apps.googleusercontent.com

# Backend API (optional — default uses Vite proxy to localhost:5000)
# VITE_API_URL=http://localhost:5000
